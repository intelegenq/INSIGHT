# ── Insight .env ──────────────────────────────────────────────────────
# Copy to .env.local and fill with real credentials for live data.
# When credentials are absent, Insight falls back to demo data gracefully.

# Data mode: "demo" = demo-only, omit/empty = live providers enabled
NEXT_PUBLIC_INSIGHT_DATA_MODE=

# ── Live provider credentials ─────────────────────────────────────────
# Helius API key — enables on-chain Solana data via Helius RPC
HELIUS_API_KEY=

# Solana RPC endpoint (public mainnet or paid RPC)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# DeFiLlama API (public, no key required)
DEFILLAMA_API_URL=https://api.llama.fi

# CoinGecko API (public, no key required)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ── Infrastructure (docker-compose) ───────────────────────────────────
# Postgres connection string
INSIGHT_POSTGRES_URL=

# Redis connection URL
INSIGHT_REDIS_URL=

# S3-compatible object storage endpoint (MinIO in docker-compose)
INSIGHT_S3_ENDPOINT=
INSIGHT_S3_BUCKET=insight-artifacts
INSIGHT_S3_REGION=us-east-1

# ── Worker ────────────────────────────────────────────────────────────
# Refresh interval in milliseconds (default: 300000 = 5 minutes)
INSIGHT_WORKER_INTERVAL_MS=300000
INSIGHT_WORKER_MAX_FAILURES=10
